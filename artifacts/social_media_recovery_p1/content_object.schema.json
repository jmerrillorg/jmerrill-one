{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jmerrill.one/schemas/content_object.schema.json",
  "title": "JM1 Canonical Content Object",
  "type": "object",
  "required": [
    "ContentId",
    "CanonicalTitle",
    "BrandOwner",
    "ContentType",
    "Topic",
    "ContentPillar",
    "PrimaryAudience",
    "JourneyStage",
    "Purpose",
    "WhyStatement",
    "SourceAuthority",
    "FactCheckStatus",
    "ComplianceStatus",
    "ApprovalStatus",
    "FounderApprovalRequired",
    "PrimaryCTA",
    "CreatedDate",
    "Evergreen",
    "SensitivityLevel",
    "AITransformAllowed",
    "AutoPublishEligible",
    "ArchiveStatus"
  ],
  "properties": {
    "ContentId": { "type": "string" },
    "CanonicalTitle": { "type": "string" },
    "BrandOwner": { "type": "string", "enum": ["J Merrill One", "J Merrill Publishing", "J Merrill Financial", "J Merrill Foundation", "J Merrill Productions"] },
    "ContributingBrands": { "type": "array", "items": { "type": "string" } },
    "ContentType": { "type": "string" },
    "Topic": { "type": "string" },
    "ContentPillar": { "type": "string" },
    "PrimaryAudience": { "type": "string" },
    "SecondaryAudience": { "type": ["string", "null"] },
    "JourneyStage": { "type": "string", "enum": ["Awareness", "Consideration", "Decision", "Onboarding", "Stewardship", "Retention", "Advocacy"] },
    "Campaign": { "type": ["string", "null"] },
    "Purpose": { "type": "string" },
    "WhyStatement": { "type": "string" },
    "SourceAuthority": { "type": "string" },
    "CanonicalSource": { "type": ["string", "null"] },
    "FactCheckStatus": { "type": "string", "enum": ["Not Started", "In Review", "Verified", "Rejected", "Expired"] },
    "ComplianceStatus": { "type": "string", "enum": ["Not Required", "Pending", "Approved", "Rejected", "Restricted"] },
    "ApprovalStatus": { "type": "string", "enum": ["Idea", "Draft", "Review", "Approved", "Rejected", "Archived"] },
    "FounderApprovalRequired": { "type": "boolean" },
    "PrimaryCTA": { "type": "string" },
    "LandingPage": { "type": ["string", "null"], "format": "uri" },
    "AssetReferences": { "type": "array", "items": { "type": "string" } },
    "CreatedDate": { "type": "string", "format": "date" },
    "PublishStartDate": { "type": ["string", "null"], "format": "date" },
    "PublishEndDate": { "type": ["string", "null"], "format": "date" },
    "Evergreen": { "type": "boolean" },
    "SensitivityLevel": { "type": "string", "enum": ["Low", "Medium", "High", "Regulated", "Crisis"] },
    "AITransformAllowed": { "type": "boolean" },
    "AutoPublishEligible": { "type": "boolean", "const": false },
    "ArchiveStatus": { "type": "string", "enum": ["Active", "Retired", "Superseded", "Archived"] }
  },
  "additionalProperties": false
}
