{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jmerrill.one/schemas/social_channel_registry.schema.json",
  "title": "JM1 Social Channel Registry",
  "type": "object",
  "required": [
    "ChannelId",
    "Brand",
    "LegalEntity",
    "Platform",
    "AccountName",
    "PublicUrl",
    "CurrentOperationalStatus",
    "ProfileAccuracyStatus",
    "RemediationPriority",
    "LastAuditDate"
  ],
  "properties": {
    "ChannelId": { "type": "string" },
    "Brand": { "type": "string", "enum": ["J Merrill One", "J Merrill Publishing", "J Merrill Financial", "J Merrill Foundation", "J Merrill Productions", "Other"] },
    "LegalEntity": { "type": "string" },
    "Platform": { "type": "string", "enum": ["Facebook", "Instagram", "LinkedIn", "YouTube", "TikTok", "X", "Threads", "Website", "Other"] },
    "AccountName": { "type": "string" },
    "Handle": { "type": ["string", "null"] },
    "PublicUrl": { "type": ["string", "null"], "format": "uri" },
    "BusinessPortfolio": { "type": ["string", "null"] },
    "BusinessManagerId": { "type": ["string", "null"] },
    "PageId": { "type": ["string", "null"] },
    "ConnectedInstagramAccount": { "type": ["string", "null"] },
    "ConnectedLinkedInAccount": { "type": ["string", "null"] },
    "ConnectedYouTubeAccount": { "type": ["string", "null"] },
    "CurrentFollowers": { "type": ["integer", "null"], "minimum": 0 },
    "CurrentFollowing": { "type": ["integer", "null"], "minimum": 0 },
    "ProfileCategory": { "type": ["string", "null"] },
    "ProfileBio": { "type": ["string", "null"] },
    "WebsiteUrl": { "type": ["string", "null"], "format": "uri" },
    "PublicPhone": { "type": ["string", "null"] },
    "PublicEmail": { "type": ["string", "null"], "format": "email" },
    "PublicAddress": { "type": ["string", "null"] },
    "BusinessHours": { "type": ["string", "null"] },
    "PrimaryCTA": { "type": ["string", "null"] },
    "ProfileImageStatus": { "type": "string", "enum": ["Current", "Needs Update", "Missing", "Unknown"] },
    "CoverImageStatus": { "type": "string", "enum": ["Current", "Needs Update", "Missing", "Unknown"] },
    "VerificationStatus": { "type": "string", "enum": ["Verified", "Unverified", "Ineligible", "Unknown"] },
    "AdminOwnershipStatus": { "type": "string", "enum": ["Confirmed", "Partial", "Missing", "Unknown"] },
    "LastPublishedDate": { "type": ["string", "null"], "format": "date" },
    "CurrentOperationalStatus": { "type": "string", "enum": ["Active", "Dormant", "Inconsistent", "Legacy", "Unknown"] },
    "ProfileAccuracyStatus": { "type": "string", "enum": ["Accurate", "Needs Update", "Inaccurate", "Unknown"] },
    "RequiredRemediation": { "type": ["string", "null"] },
    "RemediationPriority": { "type": "string", "enum": ["P0", "P1", "P2", "P3", "Unknown"] },
    "LastAuditDate": { "type": "string", "format": "date" },
    "Notes": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
